@model TrainingDBase5ticg3.ViewModels.PersonasVM

@{
    ViewBag.Title = "Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row card d-flex flex-row shadow p-3 mb-1 bg-body rounded">
        <div class="col-xs-12 col-sm-12 col-md-10 col-lg-10 justify-content-start">
            <label class="roboto-ExtraBold-800 title-morado title-size-max">
                @ViewBag.NombreCompleto
            </label>
            <p class="mt-0 mb-0">Telefono: @Model.TelefonoVM.NumeroCelular</p>
            <p class="mt-0">
                Dirección: @Model.DireccionVM.Calle
                Numero Interior:@Model.DireccionVM.NumInterior    NumeroExterior:@Model.DireccionVM.NumExterior

            </p>
            <hr />
            <button class="btn btn-bd-morado" id="btnSkill"
                    data-bs-toggle="modal" data-bs-target="#modalSkill">
                <i class="fa-solid fa-thumbs-up"></i>
                Agregar Skill
            </button>
            <button type="button" class="btn btn-outline-success" id="btnBio">
                <i class="fa-solid fa-house"></i>
                Bio
            </button>
            <button type="button" class="btn btn-outline-secondary">
                <i class="fa-solid fa-gear"></i>
                Configuraciones
            </button>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-2 col-lg-2 justify-content-end">
            <img src="~/Images/usuario_anonimo_formal.jpg"
                 alt="Descripción de la imagen" class="img-fluid img-thumbnail">
            <select class="form-select form-select-sm border border-success
                    roboto-thin-ExtraLight-200 mt-1"
                    aria-label=".form-select-sm example">
                <option selected>Asignar Roles</option>
                <option value="1">Administrador</option>
                <option value="2">Invitado</option>
                <option value="3">Analista</option>
            </select>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 mt-2 d-flex">
            <div class="mb-3 justify-content-sm-start">
                <label for="formFileSm" class="form-label">
                    <i class="fa-solid fa-camera"></i>
                    Agregar Foto
                </label>
                <input class="form-control form-control-sm" id="formFileSm"
                       type="file">
            </div>
        </div>
    </div>
    <div class="row pt-0 mt-0" id="cardRow">
        <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5
             card d-flex flex-row shadow p-3 mg-5 bg-body rounded" id="cardSkill">
            <div class="card-body" id="skillBody">
                <div class="card-title">
                    <span class="roboto-Black-900 title-morado">
                        Skill Profesionales
                    </span>
                </div>
                <hr />
                <span id="spanId"></span>
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-7 col-lg-7
             card d-flex flex-row shadow p-3 mg-5 bg-body rounded" id="carBio">
            <div class="card-body">
                <div class="card-title">
                    <span class="roboto-Black-900 title-morado">
                        Biografía
                    </span>
                    <hr />
                </div>
                <textarea class="form-control" id="txtAreaBio" rows="5"
                          placeholder="Escribe tu comentario aquí..."></textarea>
            </div>
        </div>
    </div>
    <div class="row pt-0 mt-1" id="cardCertificacionesRow">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 card
             d-flex flex-row shadow p-3 mg-5 bg-body rounded" id="carCertificaciones">
            <div class="card-body">
                <div class="card-title">
                    <span class="roboto-Black-900 title-morado">
                        Certificaciones
                    </span>
                    <hr />
                </div>
                <div class="d-flex justify-content-between">
                    <label  class="form-label">
                        Certificación:
                    </label>
                    <input type="text" class="form-control form-control-sm"
                           id="txtCerticacionNombre">
                    <label for="exampleInputPassword1"
                           class="form-label">Institución:</label>
                    <input type="text" class="form-control form-control-sm" id="txtNombreCertificacion">
                    
                    <button type="submit" class="btn btn-outline-success w-25" id="btnGuardarCertificacion">
                        Agregar
                    </button>
                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                        <div id="tablaProfesionesContainer" class="col-md-12" style="display: none;">
                            <h4 class="roboto-thin-100 title-morado">Certificaciones</h4>
                            <table class="table table-bordered" id="tablaProfesiones">
                                <thead>
                                    <tr>
                                        <th class="roboto-thin-ExtraLight-200">Certificación</th>
                                        <th class="roboto-thin-ExtraLight-200">Institución</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 d-flex flex-row align-content-lg-end">
                        <input type="submit" id="btnGuardar" class="btn btn-sm btn-success w-100"
                               value="Guardar" />
                    </div>
                </div>

            </div>
        </div>



    </div>
    <div class="row">
        <!-- Modal -->
        <div class="modal fade" id="modalSkill"
             tabindex="-1" aria-labelledby="exampleModalLabel" >
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header header-modal">
                        <h1 class="modal-title fs-5 roboto-thin-ExtraLight-200
                            header-color-text"
                            id="exampleModalLabel">
                            Agregar Skill Técnico
                        </h1>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 d-flex">
                                <p class="justify-content-start p-1">
                                    <span class="roboto-thin-100">
                                        <i class="fa-solid fa-headphones"></i>
                                        Skill:
                                    </span>

                                </p>
                                <input type="text" id="txtSkill"
                                       class="form-control form-control-sm roboto-thin-ExtraLight-200"
                                       placeholder="Nombre del skill" name="txtSkill" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary"
                                @*data-bs-dismiss="modal"*@>
                            Cerrar
                        </button>
                        <button type="button"
                                class="btn btn-outline-success" id="btnGuardarSkill">
                            Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@*<script src="~/Scripts/perfil/create-skill.js"></script>*@
<script>
    $(document).ready(function () {

        var biografia = "";
        var skills = new Array();
        var certificaciones = new Array();

        $('#txtAreaBio').prop('disabled', true);
        $('#btnGuardarSkill').click(function (event) {
            event.preventDefault();
            var txtSkill = $('#txtSkill').val();
            skills.push(txtSkill);
            ShowSpan(skills);
            Limpiar();

        });
        $('#btnBio').click(function (event) {
            event.preventDefault();
            $('#txtAreaBio').prop('disabled', false);

        });


        $('#btnGuardar').click(function () {
            biografia = $('#txtAreaBio').val();
            var PerfilVM = {};
            PerfilVM.skills = skills;
            PerfilVM.biografia = biografia;
                        
             // Enviar los datos mediante AJAX
             $.ajax({
                 url: '@Url.Action("Perfil", "Personas")', // URL del método Create
                 type: 'POST',
                 data: { perfilVM:PerfilVM },
                 headers: {
                     'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() // Incluir el token anti-falsificación
                 },
                 success: function (response) {
                     if (response.success) {
                         toastr.success('La profesión se ha creado correctamente.', 'Éxito');
                         // Redirigir a la acción Index después de una inserción exitosa
                         window.location.href = '@Url.Action("Index", "Profesiones")';
                     } else {
                         // Mostrar mensajes de error si la inserción falla
                         toastr.error('El campo "Nombre de la Profesión" es obligatorio.', 'Error');
                     }
                 },
                 error: function (xhr, status, error) {
                     toastr.error('El campo "Nombre de la Profesión" es obligatorio.', 'Error');
                 }
             });
        });


        $('#btnGuardarCertificacion').click(function () {
            let selectedText = $("#txtCerticacionNombre").val();
            let selectedValue = $("#txtNombreCertificacion").val();
            
            if (selectedValue) {
                if ($(`#tablaProfesiones tbody tr[data-id='${selectedValue}']`).length === 0) {
                    let row = `<tr data-id="${selectedValue}" class="roboto-thin-ExtraLight-200"><td>${selectedText}</td>
                    <td>${selectedValue}</td></tr>`;
                    $('#tablaProfesiones tbody').append(row);
                    $('#tablaProfesionesContainer').show();
                }
            }

            certificacion = new certificacion();
            certificacion.Nombre = selectedText;
            certificacion.Institucion = selectedValue;
            this.certificaciones.push(certificacion);
            console.log(this.certificaicones);
        });


    });

    function Limpiar() {
        $('#modalSkill').modal('hide');
        $('#txtSkill').val('');
    }
    function removeChip(element) {
        element.parentElement.remove();
    };
    function LoadInit() {
        $("#cardSkill, #carBio").hide();
        $("#cardRow").css("display", "none");
    };
    // Muestra solo el card seleccionado y oculta el otro
    function ShowCard(cardId) {

        if (cardId === '#cardSkill') {
            $("#cardSkill").show();

        }
        if (cardId === '#carBio') {
            console.log("sadff");
            $("#carBio").append();
        }
    }

    function LoadSkillOnly() {
        $("#cardRow").css("display", "flex");
        $("#carBio").css("display", "none");
    }

    function ShowData(skills) {
        $("#skillBody").empty("");
        $("#spanId").empty("");
        $("#skillBody").append('<div class="card-title"><span class="roboto-Black-900 title-morado">Skill Profesionales</span ></div > <hr />');
        $.each(skills, function (index, skill) {
            $("#skillBody").append(`
            <span class="badge bg-success text-white me-2 mt-1 roboto-Light-300" id="spanId">
                ${skill}
                <button type="button" class="btn-close btn-close-white ms-2" aria-label="Close" onclick="removeChip(this)"></button>
            </span>
        `);
        });
    }

    function ShowSpan(skills) {
        var skillContent = ''; // Variable para construir todo el contenido
        // Agregar encabezado inicial
        skillContent += '<div class="card-title"><span class="roboto-Black-900 title-morado">Skill Profesionales</span></div><hr/>';
        // Crear los elementos de habilidad
        $.each(skills, function (index, skill) {
            skillContent += `
            <span class="badge bg-success text-white me-2 mt-1 roboto-Light-300">
                ${skill}
                <button type="button" class="btn-close btn-close-white ms-2" aria-label="Close" onclick="removeChip(this)"></button>
            </span>
        `;
        });
        // Limpiar el contenido actual de skillBody
        $("#skillBody").empty();
        // Insertar todo el contenido de una sola vez
        $("#skillBody").append(skillContent);
    }


    

</script>
