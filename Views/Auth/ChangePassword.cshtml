@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm("ChangePassword", "Auth", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="container-fluid">
        <div class="row">
            <div class="card shadow-lg p-3 mb-5 bg-body-tertiary rounded">

                <div class="card-title">
                    <h2 class="roboto-Bold-700 title-morado">Change Password</h2>
                </div>
                <div class="card-subtitle roboto-thin-ExtraLight-200">
                    Apartado para cambiar el password de tu cuenta.
                    <strong>
                        @Html.ActionLink("Regresar", "Index",
new { @class = "roboto-thin-ExtraLight-200 title-morado control-label" })
                </strong>
            </div>
            <div class="card-body">
                <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
                    <div class="d-flex flex-row justify-content-between">
                        <label class="roboto-thin-ExtraLight-200 title-morado
                                   control-label">Password Actual</label>
                        <input type="password" placeholder="Ingresa tu contraseña"
                               class="form-control form-control-sm roboto-thin-ExtraLight-200"
                               id="OldPassword" name="OldPassword" required />
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5 mt-1">
                    <div class="d-flex flex-row justify-content-between">
                        <label class="roboto-thin-ExtraLight-200 title-morado
                                   control-label">Password Nuevo</label>
                        <input type="password"
                               placeholder="Ingresa tu nueva contraseña"
                               class="form-control form-control-sm roboto-thin-ExtraLight-200"
                               id="NewPassword" name="NewPassword" required />
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5 mt-2">

                    <div class="d-flex flex-row justify-content-sm-end">
                        <input type="submit" value="Actualizar"
                               class="btn btn-bd-morado w-100" />
                    </div>

                </div>
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
</div>

}


