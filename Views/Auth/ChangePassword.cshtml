@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>ChangePassword</h2>

@using (Html.BeginForm("ChangePassword", "Auth",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Usuarios</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <label class="roboto-thin-ExtraLight-200 title-morado control-label col-md-2">Password Actual</label>
            <div class="col-md-10">
                <input type="password" placeholder="Ingresa tu contraseña" class="roboto-thin-ExtraLight-200 form-control-sm" id="OldPassword" name="OldPassword"  required/>
            </div>
        </div>

        <div class="form-group">
            <label class="roboto-thin-ExtraLight-200 title-morado control-label col-md-2">Password Nuevo</label>
            <div class="col-md-10">
                <input type="password" placeholder="Ingresa tu nueva contraseña" class="roboto-thin-ExtraLight-200 form-control-sm" id="NewPassword" name="NewPassword" required />
            </div>
        </div>
              
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Actualziar" class="btn btn-bd-morado w-100" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
