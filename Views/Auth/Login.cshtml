
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row d-flex flex-row">
        <div class="align-content-center">
            <div class="card shadow-lg p-3 mb-5 bg-body-tertiary rounded">
                <div class="card-body">
                   <div  class="card-text d-flex flex-row justify-content-center">
                       <label class="text-black roboto-thin-ExtraLight-200 p-1 m-1">Nombre de Usuario:</label>
                       <input type="text" placeholder="Ingresa el Nombre de usuario" class="form-control form-control-sm p-1" />
                   </div>
                   <div class="card-text d-flex flex-row justify-content-center mt-3">
                       <label class="text-black roboto-thin-ExtraLight-200 p-1 m-1">Password:</label>
                       <input type="password" placeholder="Ingresa el Password" class="form-control form-control-sm p-1" />
                   </div>
                </div>
            </div>
        </div>
    </div>
</div>

